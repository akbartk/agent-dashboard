# Salin ke .env (chmod 600; .env tidak di-commit) lalu sesuaikan. Tidak ada rahasia di berkas ini.
# Dibaca docker-compose.yml. Isi AD_UID/AD_GID dengan pemilik folder project (id -u dan id -g).
AD_IMAGE=agent-dashboard-web
AD_TAG=lokal
# Alamat yang di-publish port web. 127.0.0.1 = hanya host ini; ganti dengan alamat jaringan bila perlu.
AD_BIND=127.0.0.1
AD_PORT=24130
AD_UID=1000
AD_GID=1000
